{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fp-validated.local/chains/_schema/staking.schema.json",
  "title": "FP Validated delegator staking facts",
  "description": "Delegator-facing staking facts. Single source for the key facts table in website/docs/staking/<chain>.md (scripts/staking-facts.mjs).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chain",
    "delegationOpen",
    "network",
    "validator",
    "commission",
    "minStake",
    "activation",
    "unbonding",
    "rewardFrequency",
    "autoCompound",
    "penalties",
    "wallets",
    "lastVerified"
  ],
  "properties": {
    "chain": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "delegationOpen": {
      "type": "boolean"
    },
    "network": {
      "type": "string",
      "minLength": 1
    },
    "token": {
      "type": "string",
      "minLength": 1
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "address",
        "explorer"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "addressLabel": {
          "type": "string",
          "minLength": 1
        },
        "explorer": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "commission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "source"
      ],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?%$"
        },
        "source": {
          "type": "string",
          "enum": [
            "onchain",
            "contract",
            "policy"
          ]
        },
        "changeNotice": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "minStake": {
      "type": "string",
      "minLength": 1
    },
    "activation": {
      "type": "string",
      "minLength": 1
    },
    "unbonding": {
      "type": "string",
      "minLength": 1
    },
    "rewardFrequency": {
      "type": "string",
      "minLength": 1
    },
    "autoCompound": {
      "type": [
        "boolean",
        "string"
      ],
      "minLength": 1
    },
    "penalties": {
      "type": "string",
      "minLength": 1
    },
    "wallets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "web",
              "mobile",
              "extension",
              "hardware",
              "custody",
              "dapp"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      },
      "description": "Wallets or official staking apps checked for this guide."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://"
      }
    },
    "lastVerified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
