{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fp-validated.local/chains/_schema/metadata.schema.json",
  "title": "FP Validated chain metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["chain", "status", "runtimes", "developerInterfaces", "ports"],
  "properties": {
    "chain": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft", "review", "published", "deprecated"] },
    "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "runtimes": {
      "oneOf": [
        {
          "type": "array",
          "items": { "type": "string", "enum": ["docker", "kubernetes", "helm", "argocd"] },
          "uniqueItems": true,
          "minItems": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["docker", "kubernetes", "helm", "argocd"],
          "properties": {
            "docker": { "type": "boolean" },
            "kubernetes": { "type": "boolean" },
            "helm": { "type": "boolean" },
            "argocd": {
              "type": "object",
              "additionalProperties": false,
              "required": ["supported", "productionRecommended"],
              "properties": {
                "supported": { "type": "boolean" },
                "productionRecommended": { "type": "boolean" }
              }
            }
          }
        }
      ]
    },
    "developerInterfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/developerInterface" }
    },
    "ports": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/port" }
    },
    "samples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "uniqueItems": true
        }
      }
    },
    "sampleLanguages": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "productionNote": { "type": "string", "minLength": 1 },
    "staking": { "$ref": "#/$defs/staking" }
  },
  "$defs": {
    "staking": {
      "description": "Delegator-facing staking facts. Single source for the key facts table in website/docs/staking/<chain>.md (scripts/staking-facts.mjs).",
      "type": "object",
      "additionalProperties": false,
      "required": ["delegationOpen", "network", "validator", "commission", "minStake", "activation", "unbonding", "rewardFrequency", "autoCompound", "penalties", "wallets", "lastVerified"],
      "properties": {
        "delegationOpen": { "type": "boolean" },
        "network": { "type": "string", "minLength": 1 },
        "token": { "type": "string", "minLength": 1 },
        "validator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "address", "explorer"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "address": { "type": "string", "minLength": 1 },
            "addressLabel": { "type": "string", "minLength": 1 },
            "explorer": { "type": "string", "pattern": "^https://" }
          }
        },
        "commission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "source"],
          "properties": {
            "value": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?%$" },
            "source": { "type": "string", "enum": ["onchain", "contract", "policy"] },
            "changeNotice": { "type": "string", "minLength": 1 }
          }
        },
        "minStake": { "type": "string", "minLength": 1 },
        "activation": { "type": "string", "minLength": 1 },
        "unbonding": { "type": "string", "minLength": 1 },
        "rewardFrequency": { "type": "string", "minLength": 1 },
        "autoCompound": { "type": "boolean" },
        "penalties": { "type": "string", "minLength": 1 },
        "wallets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "enum": ["web", "mobile", "extension", "hardware", "custody", "platform"] },
              "url": { "type": "string", "pattern": "^https://" }
            }
          }
        },
        "sources": { "type": "array", "items": { "type": "string", "pattern": "^https://" } },
        "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "developerInterface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "anyOf": [
        { "required": ["id"] },
        { "required": ["name"] }
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 _./:-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["recommended", "standard", "deprecated", "internal", "advanced"] },
        "transport": { "type": "string", "enum": ["http", "https", "ws", "wss", "grpc", "tcp", "udp"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "public": { "type": "boolean" },
        "useCases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "samples": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "migrationDeadline": { "type": "string", "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$" },
        "replacement": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
          ]
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "port", "public"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 _.-]*$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": { "type": "string", "enum": ["tcp", "udp"] },
        "public": { "type": "boolean" }
      }
    }
  }
}
