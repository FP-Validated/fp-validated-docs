{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fp-validated.local/knowledge/_schema/operator-note.schema.json",
  "title": "FP Validated operator knowledge note",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "chain",
    "topics",
    "kind",
    "review_status",
    "last_reviewed",
    "confidence",
    "summary",
    "sources"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "chain": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "topics": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "kind": {
      "type": "string",
      "enum": ["operator-note", "runbook", "snapshot", "client-intel", "source-snapshot"]
    },
    "review_status": {
      "type": "string",
      "enum": ["draft", "needs-review", "approved"]
    },
    "last_reviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "summary": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "label"],
        "properties": {
          "type": { "type": "string", "enum": ["internal", "official", "release", "snapshot-provider", "github"] },
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
